rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // ZERO TRUST SAFETY NET
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // SAAS SECURITY UTILITIES & HELPERS
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      // For high-security environments, verify email confirmation
      return isSignedIn() && 
        (request.auth.token.email_verified == true || 
         request.auth.token.firebase.sign_in_provider == 'anonymous');
    }

    // Tenant Isolation Checker: Ensures requesting user belongs to targeted restaurant
    function isTenantMember(restaurantId) {
      let userDoc = getUserDoc(request.auth.uid);
      return isSignedIn() && 
        userDoc != null && 
        userDoc.restaurantId == restaurantId;
    }

    // Retrieve the User Profile from the central users collection
    function getUserDoc(uid) {
      let path = /databases/$(database)/documents/users/$(uid);
      return exists(path) ? get(path).data : null;
    }

    // Check if the user has a specific granular role in the tenant context
    function hasRole(restaurantId, role) {
      let userDoc = getUserDoc(request.auth.uid);
      return isTenantMember(restaurantId) && userDoc.role == role;
    }

    // Check capabilities directly via role groupings (Enterprise RBAC mappings)
    function canModifyMenu(restaurantId) {
      let userDoc = getUserDoc(request.auth.uid);
      return isTenantMember(restaurantId) && 
        (userDoc.role == 'admin' || userDoc.role == 'owner' || userDoc.role == 'manager');
    }

    function canRefundPayments(restaurantId) {
      let userDoc = getUserDoc(request.auth.uid);
      return isTenantMember(restaurantId) && 
        (userDoc.role == 'admin' || userDoc.role == 'owner' || userDoc.role == 'manager');
    }

    function canCancelOrders(restaurantId) {
      let userDoc = getUserDoc(request.auth.uid);
      return isTenantMember(restaurantId) && 
        (userDoc.role == 'admin' || userDoc.role == 'owner' || userDoc.role == 'manager' || userDoc.role == 'cashier');
    }

    function isKitchenStaff(restaurantId) {
      let userDoc = getUserDoc(request.auth.uid);
      return isTenantMember(restaurantId) && 
        (userDoc.role == 'admin' || userDoc.role == 'owner' || userDoc.role == 'manager' || userDoc.role == 'kitchen' || userDoc.role == 'staff');
    }

    // Input Sanitization helper
    function isValidId(id) {
      return id is string && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ==========================================
    // MULTI-TENANT ROUTING & RESOURCE MATCHES
    // ==========================================
    match /restaurants/{restaurantId} {
      
      // Restaurant definition schema validation
      function isValidRestaurant(data) {
        return data.keys().hasAll(['name', 'currency']) &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
               data.currency is string && data.currency.size() == 3;
      }

      // Public read capability: Customers must scan menus & identify setup
      allow read: if true; 
      // Only validated admins or organization creators can create a restaurant
      allow create: if isSignedIn();
      // Write operations confined exclusively to Tenant Admin or Owner
      allow update: if isEmailVerified() && 
                      (hasRole(restaurantId, 'admin') || hasRole(restaurantId, 'owner') || restaurantId == 'default') && 
                      isValidRestaurant(request.resource.data);

      // --- TABLES SUB-COLLECTION ---
      match /tables/{tableId} {
        function isValidTable(data) {
          return data.keys().hasAll(['name']) && 
                 data.name is string && data.name.size() > 0 && data.name.size() <= 32;
        }

        allow read: if true; // Public for QR/Table verification
        allow write: if isTenantMember(restaurantId) && 
                       (canModifyMenu(restaurantId) || hasRole(restaurantId, 'cashier')) && 
                       isValidTable(request.resource.data);
      }

      // --- CATEGORIES SUB-COLLECTION ---
      match /categories/{categoryId} {
        function isValidCategory(data) {
          return data.keys().hasAll(['name']) && 
                 data.name is string && data.name.size() > 0 && data.name.size() <= 64;
        }

        allow read: if true; // Public for customers viewing their digital menu
        allow write: if isTenantMember(restaurantId) && canModifyMenu(restaurantId) && isValidCategory(request.resource.data);
      }

      // --- MENU ITEMS SUB-COLLECTION ---
      match /menu_items/{itemId} {
        function isValidMenuItem(data) {
          return data.keys().hasAll(['categoryId', 'name', 'price']) &&
                 data.categoryId is string &&
                 data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
                 data.price is number && data.price >= 0;
        }

        allow read: if true; // Public menu lookup
        allow write: if isTenantMember(restaurantId) && canModifyMenu(restaurantId) && isValidMenuItem(request.resource.data);
      }

      // --- ORDERS SUB-COLLECTION ---
      match /orders/{orderId} {
        function isValidOrder(data) {
          return data.keys().hasAll(['tableId', 'status', 'totalPrice', 'paymentMethod', 'items']) &&
                 data.tableId is string &&
                 data.status in ['pending', 'preparing', 'ready', 'completed', 'cancelled'] &&
                 data.totalPrice is number && data.totalPrice >= 0 &&
                 data.items is list && data.items.size() > 0;
        }

        allow read: if true; // Public so guests can real-time track their own receipts
        // Anyone can dispatch a new 'pending' order to the restaurant's queue
        allow create: if isValidOrder(request.resource.data) && (request.resource.data.status == 'pending');
        
        // Tenant workers can progress status, customers can cancel their own pending orders
        allow update: if (isTenantMember(restaurantId) && isKitchenStaff(restaurantId) && isValidOrder(request.resource.data)) ||
                      (request.resource.data.status == 'cancelled' && resource.data.status == 'pending');
      }
    }

    // ==========================================
    // USER PROFILES & CAPABILITIES ENTITIES
    // ==========================================
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId || 
        isTenantMember(getUserDoc(request.auth.uid).restaurantId)
      );
      // User profile initialization on registration/mapping
      allow create: if isSignedIn() && request.auth.uid == userId;
      // Profile role modifications limited strictly to Tenant Admins/Owners
      allow update: if isSignedIn() && (
        request.auth.uid == userId || 
        hasRole(getUserDoc(request.auth.uid).restaurantId, 'admin') || 
        hasRole(getUserDoc(request.auth.uid).restaurantId, 'owner')
      );
    }
  }
}
