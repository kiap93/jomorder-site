rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Global Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    
    // Check roles
    function getUserData(uid) {
      let path = /databases/$(database)/documents/users/$(uid);
      return exists(path) ? get(path).data : null;
    }
    function hasRole(role, restaurantId) {
      let userData = getUserData(request.auth.uid);
      return isVerified() && userData != null && userData.role == role && userData.restaurantId == restaurantId;
    }
    function isAdmin(restaurantId) {
      return hasRole('admin', restaurantId);
    }
    function isStaff(restaurantId) {
      let userData = getUserData(request.auth.uid);
      return isVerified() && userData != null && (userData.role == 'admin' || userData.role == 'staff' || userData.role == 'kitchen') && userData.restaurantId == restaurantId;
    }

    // 1. Restaurants
    match /restaurants/{restaurantId} {
      function isValidRestaurant(data) {
        return data.keys().hasAll(['name', 'currency']) &&
               data.name is string && data.name.size() < 100 &&
               data.currency is string && data.currency.size() == 3;
      }
      
      allow read: if true; // Publicly readable for customers to see name/settings
      allow create: if isVerified(); // Allow verified users to create their first restaurant
      allow update: if isVerified() && (isAdmin(restaurantId) || restaurantId == 'default') && isValidRestaurant(incoming());
      
      // 1.1 Tables
      match /tables/{tableId} {
        function isValidTable(data) {
          return data.keys().hasAll(['name']) && data.name is string && data.name.size() < 20;
        }
        allow read: if true;
        allow write: if isStaff(restaurantId) && isValidTable(incoming());
      }

      // 1.2 Categories
      match /categories/{categoryId} {
        function isValidCategory(data) {
          return data.keys().hasAll(['name']) && data.name is string && data.name.size() < 50;
        }
        allow read: if true;
        allow write: if isStaff(restaurantId) && isValidCategory(incoming());
      }

      // 1.3 Menu Items
      match /menu_items/{itemId} {
        function isValidMenuItem(data) {
          return data.keys().hasAll(['categoryId', 'name', 'price']) &&
                 data.categoryId is string &&
                 data.name is string && data.name.size() < 100 &&
                 data.price is number && data.price >= 0;
        }
        allow read: if true;
        allow write: if isStaff(restaurantId) && isValidMenuItem(incoming());
      }

      // 1.4 Orders
      match /orders/{orderId} {
        function isValidOrder(data) {
          return data.keys().hasAll(['tableId', 'status', 'totalPrice', 'paymentMethod', 'items']) &&
                 data.tableId is string &&
                 data.status in ['pending', 'preparing', 'ready', 'completed', 'cancelled'] &&
                 data.totalPrice is number &&
                 data.items is list && data.items.size() > 0;
        }
        
        allow read: if true; // Customers need to see their order status
        allow create: if isValidOrder(incoming()) && (incoming().status == 'pending');
        allow update: if (isStaff(restaurantId) && isValidOrder(incoming())) ||
                       (isSignedIn() && incoming().status == 'cancelled' && existing().status == 'pending');
      }
    }

    // 2. Users (Roles)
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || (getUserData(request.auth.uid) != null && isAdmin(getUserData(request.auth.uid).restaurantId)));
      allow create: if isSignedIn() && request.auth.uid == userId; 
      allow update: if isSignedIn() && (isAdmin(getUserData(request.auth.uid).restaurantId) || request.auth.uid == userId);
    }
  }
}
